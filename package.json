{
  "name": "@antmedia/webrtc-sdk",
  "version": "2.0.0-beta.1",
  "private": true,
  "description": "TypeScript WebRTC SDK for implementing a front end using Ant Media Server.",
  "license": "ISC",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "build:samples": "tsc -p tsconfig.json --outDir examples/sdk",
    "clean": "rimraf dist examples/sdk",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs": "typedoc --options typedoc.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "examples": "npm run build:samples && vite",
    "war": "npm run build:samples && mvn -q package"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.5.4",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.5",
    "typedoc": "^0.25.13",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  }
}
